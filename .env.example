# ── Choose your LLM ─────────────────────────────────────────────
# openai | openrouter | grok | gemini | ollama
LLM_PROVIDER=openai
# Optional: override the provider's default model
#   openai      gpt-5.4-mini
#   openrouter  anthropic/claude-haiku-5.5, anthropic/claude-opus-5.5, openai/gpt-5.4-mini, x-ai/grok-4.7 ...
#   grok        grok-4.7
#   gemini      gemini-2.5-flash
#   ollama      llama3.2
# LLM_MODEL=gpt-5.4-mini

# Add the key for the provider you picked
OPENAI_API_KEY=sk-...          # also enables tracing in the OpenAI dashboard
# OPENROUTER_API_KEY=sk-or-...
# XAI_API_KEY=xai-...
# GEMINI_API_KEY=...

# ── Sending (Resend preferred; SMTP is used when RESEND_API_KEY is empty) ──
RESEND_API_KEY=re_...
RESEND_FROM=ComplAI <onboarding@resend.dev>   # or an address on your verified domain

# Who receives the cold email
PROSPECT_EMAIL=you@example.com

# Inbox where replies arrive (IMAP) and SMTP fallback
EMAIL_ADDRESS=you@example.com
EMAIL_APP_PASSWORD=your-app-password
EMAIL_SMTP_SERVER=smtp.gmail.com
# IMAP_SERVER=imap.gmail.com   # optional, derived from the SMTP server

# ── Hosting (optional) ──────────────────────────────────────────
# Require a login when the app is deployed on a server (strongly recommended)
# APP_USERNAME=admin
# APP_PASSWORD=choose-a-strong-password
